    rdf:predicate dcterms:references ;
    rdf:subject <urn:rdf2ary:verification:3d-model-m> .

<https://w3id.org/rdf2ary/instance/provenance/locator-check-3d-model-m> a prov:Entity ;
    dcterms:identifier "Smithsonian Voyager Story::白马模型.glb:Dbjzc2xDKRus" ;
