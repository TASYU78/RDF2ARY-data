<https://w3id.org/rdf2ary/instance/selector/locator-check-3d-model-m/1> a rdf2ary:SpatialPointSelector ;
    rdf2ary:hasCoordinateSystem rdf2ary:ModelCoordinateSpace ;
    rdf2ary:hasCoordinateUnit rdf2ary:MetreUnit ;
    rdf2ary:x 1.25 ;
    rdf2ary:y -2.0 ;
    rdf2ary:z 3.5 .

<https://w3id.org/rdf2ary/instance/software/Smithsonian%20Voyager%20Story> a prov:SoftwareAgent ;
