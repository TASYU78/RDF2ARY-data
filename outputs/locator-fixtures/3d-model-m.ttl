<https://w3id.org/rdf2ary/instance/annotation/locator-check-3d-model-m> a rdf2ary:Annotation ;
    dcterms:identifier "locator-check-3d-model-m" ;
    prov:wasDerivedFrom <https://w3id.org/rdf2ary/instance/provenance/locator-check-3d-model-m> ;
    rdf2ary:hasAssertion <https://w3id.org/rdf2ary/instance/assertion/locator-check-3d-model-m> ;
    rdf2ary:hasTarget <https://w3id.org/rdf2ary/instance/target/locator-check-3d-model-m> .

<https://w3id.org/rdf2ary/instance/assertion/locator-check-3d-model-m> a rdf2ary:SemanticAssertion ;
