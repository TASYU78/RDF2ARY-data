@extensions [{"exact": "少小去乡邑，扬声沙漠垂。", "language": "zh-Hans", "prefix": "连翩西北驰。\n借问谁家子，幽并游侠儿。\n", "suffix": "\n宿昔秉良弓，楛矢何参差。\n控弦破左的，", "type": "text_quote"}]
