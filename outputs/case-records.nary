@extensions [{"exact": "借问谁家子，幽并游侠儿。", "language": "zh-Hans", "prefix": "白马饰金羁，连翩西北驰。\n", "suffix": "\n少小去乡邑，扬声沙漠垂。\n宿昔秉良弓，", "type": "text_quote"}]
